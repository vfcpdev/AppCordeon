      </attributes>
      <direction><direction-type><words font-weight="bold">Paseo (4/4)</words></direction-type></direction>
      <note><pitch><step>C</step><octave>4</octave></pitch><duration>2</duration><voice>1</voice><type>quarter</type></note>
