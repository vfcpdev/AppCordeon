            </attributes>
            <barline location="left"><repeat direction="forward"/></barline>
            <note><unpitched><display-step>B</display-step><display-octave>4</display-octave></unpitched><duration>2</duration><voice>1</voice><type>eighth</type><notehead>x</notehead></note>
