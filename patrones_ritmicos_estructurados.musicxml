            <note><unpitched><display-step>A</display-step><display-octave>4</display-octave></unpitched><duration>1</duration><voice>1</voice><type>eighth</type><notehead>x</notehead></note>
            <note><unpitched><display-step>A</display-step><display-octave>4</display-octave></unpitched><duration>1</duration><voice>1</voice><type>eighth</type><notehead>normal</notehead></note>
            <note><unpitched><display-step>A</display-step><display-octave>4</display-octave></unpitched><duration>1</duration><voice>1</voice><type>eighth</type><notehead>x</notehead></note>
