            <note><unpitched><display-step>A</display-step><display-octave>4</display-octave></unpitched><duration>4</duration><voice>1</voice><type>quarter</type><notehead>x</notehead></note>
            <note><unpitched><display-step>A</display-step><display-octave>4</display-octave></unpitched><duration>4</duration><voice>1</voice><type>quarter</type><notehead>normal</notehead></note>
