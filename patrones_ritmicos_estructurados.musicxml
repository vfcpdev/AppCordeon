        <measure number="9">
            <barline location="left"><ending number="2" type="start"/></barline>
            <note><unpitched><display-step>A</display-step><display-octave>4</display-octave></unpitched><duration>6</duration><voice>1</voice><type>half</type><dot/></note>
            <barline location="right"><ending number="2" type="discontinue"/></barline>
