            </note>
            <note>
                <pitch>
                    <step>C</step>
                    <octave>4</octave>
                </pitch>
                <duration>4</duration>
                <voice>1</voice>
                <type>quarter</type>
            </note>
            <barline location="right">
                <ending number="1" type="stop" />
                <repeat direction="backward" />
            </barline>
        </measure>
        <measure number="3">
